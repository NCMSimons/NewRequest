
name: Improved Model Request
description: Request an improvement to an existing AI model.
title: "[Improved Model] "
body:
  - type: markdown
    attributes:
      value: |
        # 1. General Information
        All fields are optional.

  - type: input
    id: sport
    attributes:
      label: Sport

  - type: input
    id: target_date
    attributes:
      label: Target Date
      placeholder: "YYYY-MM-DD"

  - type: input
    id: customer
    attributes:
      label: Customer / Client

  - type: input
    id: request_owner
    attributes:
      label: Request Owner

  - type: dropdown
    id: priority
    attributes:
      label: Priority
      options:
        - Low
        - Medium
        - High
        - Critical

  - type: textarea
    id: reason
    attributes:
      label: Reason for Request

  - type: input
    id: requesters
    attributes:
      label: Amount of Requesters
      description: Filled in internally.

  - type: markdown
    attributes:
      value: |
        # 2. Current Model and Improvement Scope

  - type: dropdown
    id: model
    attributes:
      label: Model / Feature
      options:
        - VD Pro - Main
        - VD Pro - Tactical
        - VD Pro - Close-Up
        - VD Pro - Specific Event Moment
        - VD Regular - Main
        - VD Regular - Tactical
        - Event Detection
        - Other

  - type: input
    id: model_version
    attributes:
      label: Current Model Version

  - type: textarea
    id: current_usage
    attributes:
      label: Where Is the Model Currently Used?

  - type: textarea
    id: current_performance
    attributes:
      label: Current Performance / Known Limitations

  - type: textarea
    id: examples
    attributes:
      label: Examples of Issues or Undesired Output
      description: Add links to clips, screenshots, or match references.

  - type: textarea
    id: improvement
    attributes:
      label: What Needs to Improve?

  - type: textarea
    id: desired_output
    attributes:
      label: Expected Model Behaviour / Desired Output

  - type: dropdown
    id: improvement_area
    attributes:
      label: Main Improvement Area
      options:
        - Accuracy / Quality
        - Consistency / Reliability
        - Coverage
        - Robustness
        - Specific Events or Situations
        - Other

  - type: dropdown
    id: scope
    attributes:
      label: Scope of Improvement
      options:
        - General improvement for all customers
        - Specific sport / competition
        - Customer-specific improvement
        - To be assessed

  - type: textarea
    id: unchanged
    attributes:
      label: What Should Remain Unchanged?

  - type: markdown
    attributes:
      value: |
        # 3. Business / Sales

  - type: input
    id: sales_customer
    attributes:
      label: Customer / Prospect

  - type: dropdown
    id: customer_status
    attributes:
      label: Customer Status
      options:
        - New customer
        - Existing customer
        - Prospect
        - Other

  - type: dropdown
    id: contract_related
    attributes:
      label: Contract / Deal Related?
      options:
        - "Yes"
        - "No"
        - To be confirmed

  - type: textarea
    id: revenue
    attributes:
      label: Revenue Potential / Retention Impact

  - type: textarea
    id: expected_scale
    attributes:
      label: Expected Number of Users / Teams / Matches / Locations

  - type: input
    id: target_market
    attributes:
      label: Target Market / League / Competition

  - type: dropdown
    id: strategic_importance
    attributes:
      label: Strategic Importance
      options:
        - Low
        - Medium
        - High
        - Critical
        - To be assessed

  - type: dropdown
    id: reusability
    attributes:
      label: Customer-Specific or Reusable?
      options:
        - Customer-specific
        - Reusable for multiple customers
        - Potentially reusable
        - To be assessed

  - type: textarea
    id: business_reason
    attributes:
      label: Why Is This Needed to Win or Retain the Customer?

  - type: textarea
    id: impact_if_not_delivered
    attributes:
      label: Business Impact if Not Delivered

  - type: markdown
    attributes:
      value: |
        # 4. Model and Technical Requirements

  - type: textarea
    id: current_quality
    attributes:
      label: Current Quality / Baseline

  - type: textarea
    id: target_quality
    attributes:
      label: Target Quality / Success Criteria

  - type: textarea
    id: dependencies
    attributes:
      label: Dependencies or Technical Constraints

  - type: textarea
    id: reusable_functionality
    attributes:
      label: Existing Models / Functionality That Can Be Reused

  - type: textarea
    id: tradeoffs
    attributes:
      label: Potential Side Effects or Trade-offs

  - type: textarea
    id: requirements_guide
    attributes:
      label: Model Requirements Guide
      description: Add a link or reference to the relevant guide.

  - type: input
    id: rules_contact
    attributes:
      label: Contact Person for Rules / Special Events

  - type: markdown
    attributes:
      value: |
        # 5. Data and Validation

  - type: dropdown
    id: data_available
    attributes:
      label: Is Sufficient Data Available?
      options:
        - "Yes"
        - "No"
        - Partially
        - To be confirmed

  - type: dropdown
    id: data_checked
    attributes:
      label: Have Data Requirements Been Checked?
      options:
        - "Yes"
        - "No"
        - To be confirmed

  - type: textarea
    id: data_sources
    attributes:
      label: Available Data Sources / Sample Matches

  - type: textarea
    id: data_gaps
    attributes:
      label: Data Gaps or Additional Data Needed

  - type: textarea
    id: annotation
    attributes:
      label: Annotation Requirements

  - type: input
    id: data_owner
    attributes:
      label: Responsible Team / Owner

  - type: input
    id: target_test_date
    attributes:
      label: Target Test Date
      placeholder: "YYYY-MM-DD"

  - type: textarea
    id: test_scenarios
    attributes:
      label: Test Locations / Matches / Scenarios

  - type: textarea
    id: validation
    attributes:
      label: Validation Method and Acceptance Criteria

  - type: input
    id: validator
    attributes:
      label: Who Will Validate and Approve the Improvement?

  - type: markdown
    attributes:
      value: |
        # 6. Expected Outcome and Internal Assessment

  - type: textarea
    id: expected_outcome
    attributes:
      label: Expected Outcome / Definition of Success

  - type: textarea
    id: expected_benefits
    attributes:
      label: Expected Customer / Business Benefit

  - type: textarea
    id: internal_assessment
    attributes:
      label: Internal Assessment
      description: For internal use - feasibility, effort, dependencies, risks, owner, and planned delivery date.

  - type: dropdown
    id: status
    attributes:
      label: Request Status
      options:
        - Submitted
        - Under assessment
        - Approved
        - In development
        - In testing
        - Delivered
        - Rejected / On hold
